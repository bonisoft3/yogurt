{
  "access": {
    "app_user": {
      "scope": "public"
    },
    "me": {
      "owner": "id",
      "scope": "private"
    },
    "friend_request_sent": {
      "owner": "from_id",
      "scope": "private"
    },
    "friend_request": {
      "owner": "to_id",
      "scope": "private"
    },
    "friendship": {
      "scope": "public"
    },
    "scrap": {
      "scope": "public"
    },
    "testimonial_draft": {
      "owner": "author_id",
      "scope": "private"
    },
    "testimonial_pending": {
      "owner": "subject_id",
      "scope": "private"
    },
    "testimonial": {
      "scope": "public"
    },
    "fan": {
      "scope": "public"
    },
    "karma": {
      "owner": "rater_id",
      "scope": "private"
    },
    "karma_smiley": {
      "scope": "public"
    },
    "feed_item": {
      "owner": "reader_id",
      "scope": "private"
    },
    "community": {
      "scope": "public"
    },
    "membership": {
      "scope": "public"
    },
    "topic": {
      "scope": "public"
    },
    "post": {
      "scope": "public"
    }
  },
  "app": "yogurt",
  "auth": {
    "required": true,
    "service": "/auth",
    "self": {
      "route": "profile",
      "name": {
        "table": "app_user",
        "column": "display_name"
      }
    },
    "promote": true,
    "mode": "passkey"
  },
  "floors": {
    "touch": 24
  },
  "i18n": {
    "default": "pt-BR",
    "locales": {
      "pt-BR": {
        "path": "pt-br"
      },
      "en": {
        "path": "en"
      }
    }
  },
  "local": {
    "community_search": "tab",
    "search": "tab"
  },
  "read": {
    "friendship": "lazy",
    "scrap": "lazy",
    "testimonial": "lazy",
    "fan": "lazy",
    "karma_smiley": "lazy",
    "community": "lazy",
    "membership": "lazy",
    "topic": "lazy",
    "post": "lazy"
