  "tables": [
    "app_user",
    "community",
    "fan",
    "feed_item",
    "friend_request",
    "friend_request_sent",
    "friendship",
    "karma",
    "karma_smiley",
    "me",
    "membership",
    "post",
    "scrap",
    "testimonial",
    "testimonial_draft",
    "testimonial_pending",
    "topic"
  ],
  "schema": {
    "app_user": {
      "durability": "server",
      "fields": [
        {
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "bounds": {
            "sizeMin": 1
          },
          "name": "handle",
          "type": "string",
          "required": true,
          "unique": true
        },
        {
          "bounds": {
            "sizeMax": 60
          },
          "name": "display_name",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMax": 2048,
            "regex": "^(https://|/pictures/[0-9a-f]{64}\\.(jpg|png|webp)$)"
          },
          "name": "photo_url",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMax": 1000
          },
          "name": "about",
          "type": "string",
          "required": false
        },
        {
          "default": "rel_unsaid",
          "defaulted": true,
          "enum": [
            "rel_unsaid",
            "rel_single",
            "rel_dating",
            "rel_married",
            "rel_open",
            "rel_complicated"
          ],
          "name": "relationship",
          "type": "string",
          "required": true
        },
        {
          "bounds": {
            "sizeMax": 80
          },
          "name": "city",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMax": 60
          },
          "name": "country",
          "type": "string",
          "required": false
        },
        {
          "name": "birthday",
          "type": "date",
          "required": false
        },
        {
          "bounds": {
            "sizeMax": 300
          },
          "name": "passions",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMax": 300
          },
          "name": "music",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMax": 300
          },
          "name": "movies",
          "type": "string",
          "required": false
        },
        {
          "bounds": {
            "sizeMax": 300
          },
          "name": "books",
          "type": "string",
          "required": false
        },
        {
          "defaulted": true,
          "name": "created_at",
          "type": "timestamp",
          "required": true
        },
        {
          "name": "search_text",
          "type": "string",
          "required": true
        }
      ]
    },
    "me": {
      "durability": "live",
      "fields": [
        {
          "name": "id",
          "pk": true,
          "ref": "app_user",
          "type": "uuid",
          "required": true
        },
        {
          "bounds": {
            "sizeMin": 1
          },
          "name": "handle",
          "type": "string",
          "required": true
        }
      ]
    },
    "friend_request_sent": {
      "durability": "live",
      "fields": [
        {
          "defaulted": true,
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "defaulted": true,
          "name": "from_id",
          "ref": "app_user",
          "type": "uuid",
          "required": true
        },
        {
          "name": "to_id",
          "ref": "app_user",
          "type": "uuid",
          "required": true
        },
        {
          "defaulted": true,
          "name": "created_at",
          "type": "timestamp",
          "required": true
        }
      ],
      "uniques": [
        {
          "name": "uq_friend_request_sent_pair",
          "cols": [
            "from_id",
            "to_id"
          ]
        }
      ]
    },
    "friend_request": {
      "durability": "live",
      "fields": [
        {
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "name": "from_id",
          "ref": "app_user",
          "type": "uuid",
          "required": true
        },
        {
          "name": "to_id",
          "ref": "app_user",
          "type": "uuid",
          "required": true
        },
        {
          "default": false,
          "defaulted": true,
          "name": "accepted",
          "type": "bool",
          "required": true
        },
        {
          "defaulted": true,
          "name": "created_at",
          "type": "timestamp",
          "required": true
        }
      ],
      "uniques": [
        {
          "name": "uq_friend_request_pair",
          "cols": [
            "from_id",
            "to_id"
          ]
        }
      ]
    },
    "friendship": {
      "durability": "live",
      "fields": [
        {
          "defaulted": true,
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "name": "user_id",
          "ref": "app_user",
          "type": "uuid",
          "required": true
        },
        {
          "name": "friend_id",
          "ref": "app_user",
          "type": "uuid",
          "required": true
        },
        {
          "defaulted": true,
          "name": "created_at",
          "type": "timestamp",
          "required": true
        }
      ],
      "uniques": [
        {
          "name": "uq_friendship_pair",
          "cols": [
            "user_id",
            "friend_id"
          ]
        }
      ]
    },
    "scrap": {
      "durability": "server",
      "fields": [
        {
          "defaulted": true,
          "name": "id",
          "pk": true,
          "type": "uuid",
          "required": true
        },
        {
          "name": "owner_id",
          "ref": "app_user",
          "type": "uuid",
          "required": true
        },
        {
          "defaulted": true,
          "name": "author_id",
          "ref": "app_user",
          "type": "uuid",
          "required": true
        },
        {
          "bounds": {
            "sizeMin": 1,
            "sizeMax": 1000
          },
          "name": "body",
          "type": "string",
          "required": true
        },
        {
          "defaulted": true,
          "name": "created_at",
          "type": "timestamp",
          "required": true
        }
      ]
    },
    "testimonial_draft": {
      "durability": "live",
      "fields": [
        {
          "defaulted": true,
          "name": "id",
          "pk": true,
          "type": "uuid",
