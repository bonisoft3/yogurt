f in /docker-entrypoint-initdb.d/*.sql; do' '    if [ -f \"$f\" ]; then' '      base=$(basename \"$f\")' '      case \"$base\" in *seed*) continue;; esac' '      applied=$(setpriv --reuid=postgres --regid=postgres --clear-groups psql -t -A -U postgres -d \"$POSTGRES_DB\" -c \"SELECT count(*) FROM _pronto_migrations WHERE name = $q$base$q\")' '      if [ \"$applied\" = \"0\" ]; then' '        echo \"Applying pending migration $f...\"' '        setpriv --reuid=postgres --regid=postgres --clear-groups psql -v ON_ERROR_STOP=1 -U postgres -d \"$POSTGRES_DB\" -f \"$f\"' '        setpriv --reuid=postgres --regid=postgres --clear-groups psql -U postgres -d \"$POSTGRES_DB\" -c \"INSERT INTO _pronto_migrations (name) VALUES ($q$base$q)\"' '      fi' '    fi' '  done' '  setpriv --reuid=postgres --regid=postgres --clear-groups pg_ctl -D \"$PGDATA\" -m fast -w stop' 'fi' 'if [ \"$1\" = \"postgres\" ]; then shift; fi' 'exec setpriv --reuid=postgres --regid=postgres --clear-groups postgres -D \"$PGDATA\" -c listen_addresses=127.0.0.1 \"$@\"' > /usr/local/bin/docker-entrypoint.sh && chmod 755 /usr/local/bin/docker-entrypoint.sh",
